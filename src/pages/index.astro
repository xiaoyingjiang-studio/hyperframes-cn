---
import discovery from '../../content/discovery.json';
import StudioLayout from '../ui/StudioLayout.astro';

const introduction = discovery.pages.find(page => page.id === 'studio-home');
if (!introduction?.title) throw new Error('未登记工作室首页标题和摘要');
const hero = '/media/xiaoyingjiang-creator.webp';
const mobileHero = '/media/xiaoyingjiang-creator-mobile.webp';
const heroSources = `${mobileHero} 768w, ${hero} 1440w`;
const heroSizes = '(max-width: 760px) 100vw, (max-width: 1440px) 52vw, 710px';
const heroAlt = '录音麦克风旁，一只手在数位屏上绘制解说分镜';
const wechat = import.meta.env.PUBLIC_STUDIO_WECHAT_ID?.trim();
const contactInput = import.meta.env.PUBLIC_STUDIO_CONTACT_URL?.trim();
const contactUrl = contactInput ? new URL(contactInput) : undefined;
if (contactUrl && (!['https:', 'mailto:'].includes(contactUrl.protocol) || contactUrl.username || contactUrl.password || (contactUrl.protocol === 'mailto:' && (!contactUrl.pathname.includes('@') || contactUrl.search || contactUrl.hash)))) {
  throw new Error('PUBLIC_STUDIO_CONTACT_URL 必须是公开的 HTTPS 链接或 mailto 邮箱地址');
}
const brief = '你好，我想和小影匠聊聊出海合作。\n\n代表作链接：\n我平时做的内容：\n我想先尝试的方向：';
const emailLink = contactUrl?.protocol === 'mailto:'
  ? `${contactUrl.href}?subject=${encodeURIComponent('原创内容出海合作')}&body=${encodeURIComponent(brief)}`
  : undefined;
const steps = [
  { title: '你提供作品', description: '发一条代表作。方向和首版由你确认，之后按自己的节奏继续创作。' },
  { title: '我们负责试运营', description: '先约定给谁看、在哪发、试多久。小影匠按约定完成脚本改编、剪辑、字幕或配音和发布。' },
  { title: '一起决定下一步', description: '试完一起看成片、发布记录和观众反馈，再决定继续做、换个方向，还是先暂停。' },
];
const review = [
  { title: '改了什么', description: '选了哪条作品、改了哪些地方、发布了哪个版本。' },
  { title: '观众怎么看', description: '从曝光、点击和开头留存找线索，标出反馈还不够的地方。' },
  { title: '下一条怎么做', description: '给出继续、调整或暂停的建议，以及这个判断的依据。' },
];
const questions = [
  { title: '可以保留原来的创作方式吗？', answer: '可以从已有的旁白、图解、动画或录屏开始。哪些部分保留，哪些需要调整字幕、脚本或配音，我们会根据目标观众和你一起确认。' },
  { title: '账号、素材和收益怎么约定？', answer: '开始前一起写清账号持有与管理权限、素材和成片的使用范围、数据如何查看。若涉及费用或收益分账，同时明确口径与结算时间。' },
  { title: '试过之后发现方向不合适怎么办？', answer: '试运营的时长和范围提前约定。复盘后可以决定暂停，合作前会把内容与数据如何交接、权限如何撤回写清楚。' },
];
---
<StudioLayout title={introduction.title} description={introduction.answer}>
  <section class="creator-wrap creator-hero" aria-labelledby="hero-title">
    <div class="creator-hero-copy">
      <p class="creator-kicker"><span aria-hidden="true"></span>中国创作者的出海伙伴</p>
      <h1 id="hero-title"><span>你专心创作，</span><span>我们负责</span><span>海外运营。</span></h1>
      <p class="answer-summary creator-intro">{introduction.answer}</p>
      <div class="creator-actions">
        <a class="creator-button creator-primary" href="#contact">带一条作品聊出海</a>
        <a class="creator-text-link" href="#adaptation">看内容怎么改编</a>
      </div>
    </div>

    <figure class="creator-hero-art">
      <div class="creator-viewfinder">
        <picture>
          <source media="(max-width: 540px)" srcset={mobileHero} />
          <img src={hero} srcset={heroSources} sizes={heroSizes} alt={heroAlt} width="1440" height="960" fetchpriority="high" />
        </picture>
        <div class="creator-viewfinder-marks" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
      </div>
    </figure>
  </section>

  <section class="creator-example" id="adaptation" aria-labelledby="example-title">
    <div class="creator-wrap creator-example-inner">
      <div class="creator-section-heading">
        <div><p class="creator-kicker">改编示例</p><h2 id="example-title">同一条作品，<br />给新观众一个好开头。</h2></div>
        <p>如果英语观众第一次刷到你的复利解说，什么会让他们想看下去？我们会保留原来的解释，用一个问题和一组数字带他们入题。</p>
      </div>
      <div class="creator-comparison">
        <figure>
          <div class="creator-demo creator-original"><p>一张图看懂<br />什么是<span>复利</span></p><div class="creator-coin" aria-hidden="true"></div></div>
          <figcaption><strong>中文原版开场</strong><span>直接点题，适合已经想了解「复利」的观众。</span></figcaption>
        </figure>
        <figure>
          <div class="creator-demo creator-adapted" lang="en">
            <p>What if your<br />interest earned<br /><em>interest?</em></p>
            <div class="creator-stacks" aria-hidden="true">
              <span><i></i>100</span><span><i></i>110</span><span><i></i>121</span>
            </div>
          </div>
          <figcaption><strong>英语版开场</strong><span>先问「如果利息也能生利息呢？」用 100、110、121 解释为什么同样按 10% 计算，第二次多了 1。</span></figcaption>
        </figure>
      </div>
      <div class="creator-example-foot">
        <p class="creator-example-note">工作室自制分镜示例</p>
        <a class="creator-text-link" href="/creators/mandarin-video-localization/">读完整改编拆解</a>
      </div>
    </div>
  </section>

  <section class="creator-wrap creator-cooperate" id="cooperate" aria-labelledby="cooperate-title">
    <div class="creator-section-heading">
      <div><p class="creator-kicker">合作方式</p><h2 id="cooperate-title">先试一轮，<br />再决定要不要继续。</h2></div>
      <p>一次先选一类观众、一个平台。你把时间留给创作，我们把约定的海外运营做完，再和你一起看结果。</p>
    </div>
    <ol class="creator-steps">
      {steps.map(step => <li><h3>{step.title}</h3><p>{step.description}</p></li>)}
    </ol>
    <div class="creator-review">
      <h3>试完能看到什么？</h3>
      <dl>
        {review.map(item => <div><dt>{item.title}</dt><dd>{item.description}</dd></div>)}
      </dl>
    </div>
    <div class="creator-questions">
      <h3>合作前，先说清楚。</h3>
      <div class="creator-accordion">
        {questions.map(question => <details><summary>{question.title}</summary><p>{question.answer}</p></details>)}
      </div>
    </div>
  </section>

  <section class="creator-wrap creator-readiness" id="readiness" aria-labelledby="readiness-title">
    <div>
      <h2 id="readiness-title">已经在做自己的栏目？</h2>
      <p>如果你在持续做旁白解说、手绘图解、动画或录屏，有一条可以授权的代表作，就可以拿它来聊。已经发过海外版的话，也可以带那条来，一起看看哪里值得接着试。</p>
    </div>
    <a class="creator-text-link" href="/creators/readiness/">看看你的作品适不适合</a>
  </section>

  <section class="creator-wrap creator-contact-wrap" id="contact" aria-labelledby="contact-title">
    <div class="creator-contact">
      <div>
        <p class="creator-kicker">聊聊合作</p>
        <h2 id="contact-title">发一条<br />你的代表作。</h2>
        <p>我们先看这条作品哪里值得保留、适合给谁看，以及第一版可以怎么改。</p>
      </div>
      <div class="creator-brief">
        <h3>发什么给我们</h3>
        <p class="creator-brief-instructions">一条可访问的代表作链接就可以开始。如果你已经有想尝试的方向，也可以一起告诉我们。</p>
        {wechat ? (
          <div class="creator-wechat" data-pagefind-ignore>
            <p>微信号 <strong>{wechat}</strong></p>
            <button type="button" class="creator-button creator-primary" data-copy-text={wechat} data-copy-success="已复制微信号。添加时可以备注「出海合作」。" hidden>复制微信号</button>
          </div>
        ) : contactUrl ? (
          <a class="creator-button creator-primary" href={emailLink || contactUrl.href}>{emailLink ? '邮件联系小影匠' : '联系小影匠'}</a>
        ) : <>
          <p class="creator-contact-note">联系方式稍后更新。现在可以先保存合作模板。</p>
          <noscript><textarea readonly class="creator-copy-fallback" aria-label="合作模板">{brief}</textarea></noscript>
        </>}
        {(!emailLink || wechat) && <button type="button" class="creator-button creator-copy" data-copy-text={brief} data-copy-success="已复制合作模板。" hidden data-pagefind-ignore>复制合作模板</button>}
        <p class="creator-copy-status" role="status" data-copy-status data-pagefind-ignore></p>
        <textarea readonly hidden class="creator-copy-fallback" data-copy-fallback aria-label="待复制内容" data-pagefind-ignore></textarea>
      </div>
    </div>
  </section>
</StudioLayout>

<script>
  const copyStatus = document.querySelector<HTMLParagraphElement>('[data-copy-status]');
  const fallback = document.querySelector<HTMLTextAreaElement>('[data-copy-fallback]');
  if (copyStatus && fallback) {
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-text]')) {
      button.hidden = false;
      button.addEventListener('click', async () => {
        const text = button.dataset.copyText ?? '';
        try {
          await navigator.clipboard.writeText(text);
          copyStatus.textContent = button.dataset.copySuccess ?? '已复制。';
          fallback.hidden = true;
        } catch {
          fallback.value = text;
          fallback.hidden = false;
          fallback.focus();
          fallback.select();
          copyStatus.textContent = '可以手动复制下方内容。';
        }
      });
    }
  }
</script>
