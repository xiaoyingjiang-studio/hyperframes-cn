---
import { studioDownload } from '../lib/site';
import '../styles/navigation.css';
const path = Astro.url.pathname;
const links = [
  { label: 'Studio', href: '/hyperframes/', active: path === '/hyperframes/' },
  { label: '作品', href: '/showcase/', active: path.startsWith('/showcase') },
  { label: '中文指南', href: '/knowledge/', active: /^\/(knowledge|studio|skills|mechanisms|capabilities|start|overview|features|guides)\//.test(path) },
  { label: '更新', href: '/updates/', active: path.startsWith('/updates') },
];
---
<div class="site-header">
  <a href="/hyperframes/" class="brand" aria-label="HyperFrames 中文指南首页"><span class="brand-icon" aria-hidden="true">H<span>F</span></span><span>HyperFrames<small>中文指南</small></span></a>
  <nav aria-label="主导航">
    {path === '/hyperframes/' && <span class="studio-nav-indicator" aria-hidden="true"></span>}
    {links.map(link => <a href={link.href} aria-current={link.active ? 'page' : undefined}>{link.label}</a>)}
  </nav>
  <div class="header-actions">
    <button class="search-trigger" aria-label="搜索网站" data-search-open><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg><span>搜索文档</span><kbd>Ctrl K</kbd></button>
    <button class="theme-toggle" aria-label="切换明暗主题" title="切换明暗主题">◐</button>
    <a class="header-download" href={studioDownload}>下载 Studio</a>
  </div>
  <details class="mobile-navigation">
    <summary>导航</summary>
    <nav aria-label="移动主导航">
      {links.map(link => <a href={link.href} aria-current={link.active ? 'page' : undefined}>{link.label}</a>)}
      <a href={studioDownload}>下载 Studio<span>官方入口</span></a>
    </nav>
  </details>
</div>
<dialog id="site-search" aria-labelledby="search-title">
  <div class="search-heading"><h2 id="search-title">搜索中文指南</h2><button data-search-close aria-label="关闭搜索">关闭 <kbd>Esc</kbd></button></div>
  <label for="search-input" class="sr-only">输入关键词</label><input id="search-input" type="search" placeholder="试试「字幕」「Codex」「render」" autocomplete="off" />
  <p class="search-note" aria-live="polite">输入中文关键词、功能名称或命令。</p><ul id="search-results" aria-label="搜索结果"></ul>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('#site-search')!;
  const input = document.querySelector<HTMLInputElement>('#search-input')!;
  const results = document.querySelector<HTMLUListElement>('#search-results')!;
  const note = document.querySelector<HTMLParagraphElement>('.search-note')!;
  const open = () => { dialog.showModal(); input.focus(); };
  document.querySelector('[data-search-open]')?.addEventListener('click', open);
  document.querySelector('[data-search-close]')?.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
  dialog.addEventListener('keydown', event => { if (event.key === 'Escape') { event.preventDefault(); event.stopPropagation(); dialog.close(); } });
  document.addEventListener('keydown', event => { if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') { event.preventDefault(); open(); } });
  let request = 0;
  input.addEventListener('input', async () => {
    const current = ++request;
    const query = input.value.trim();
    results.replaceChildren();
    if (!query) { note.textContent = '输入中文关键词、功能名称或命令。'; return; }
    note.textContent = '正在搜索…';
    try {
      // Built locally by Pagefind. No query is sent to a server.
      const url = '/pagefind/pagefind.js';
      const pagefind = await import(/* @vite-ignore */ url);
      const response = await pagefind.search(query);
      const entries = await Promise.all(response.results.slice(0, 8).map((r: { data: () => Promise<{ url: string; meta: { title: string }; excerpt: string }> }) => r.data()));
      if (current !== request) return;
      note.textContent = entries.length ? `找到 ${response.results.length} 条结果` : '没有找到结果，试试更短的关键词。';
      for (const entry of entries) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = entry.url; a.textContent = entry.meta.title;
        const p = document.createElement('p');
        // Pagefind excerpts are text; avoid treating source content as HTML.
        p.textContent = entry.excerpt.replace(/<[^>]*>/g, '');
        li.append(a, p); results.append(li);
      }
    } catch {
      if (current === request) note.textContent = '搜索索引暂不可用。开发环境请先构建并运行 pnpm preview；也可使用文档侧栏。';
    }
  });
  document.querySelector('.theme-toggle')?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    const key = document.documentElement.dataset.themeScope === 'studio' ? 'hyperframes-studio-theme' : 'starlight-theme';
    try { localStorage.setItem(key, next); } catch {}
  });
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-navigation');
  menu?.addEventListener('keydown', event => {
    if (event.key === 'Escape') { menu.open = false; menu.querySelector('summary')?.focus(); }
  });
  menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { menu.open = false; }));
  document.addEventListener('click', event => {
    if (menu?.open && event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
  });
  const navigation = document.querySelector<HTMLElement>('.studio-home .site-header > nav');
  const indicator = navigation?.querySelector<HTMLElement>('.studio-nav-indicator');
  if (navigation && indicator) {
    navigation.classList.add('has-indicator');
    const current = navigation.querySelector<HTMLAnchorElement>('a[aria-current]')!;
    const follow = (link: HTMLAnchorElement) => {
      indicator.style.width = `${link.offsetWidth}px`;
      indicator.style.transform = `translateX(${link.offsetLeft}px)`;
    };
    navigation.querySelectorAll<HTMLAnchorElement>('a').forEach(link => {
      link.addEventListener('pointerenter', () => follow(link));
      link.addEventListener('focus', () => follow(link));
    });
    navigation.addEventListener('pointerleave', () => follow(navigation.contains(document.activeElement) ? document.activeElement as HTMLAnchorElement : current));
    navigation.addEventListener('focusout', event => { if (!navigation.contains(event.relatedTarget as Node)) follow(current); });
    new ResizeObserver(() => follow(current)).observe(navigation);
    document.fonts.ready.then(() => follow(current));
    follow(current);
  }
</script>
