import { site } from '../lib/site';
import health from '../../content/sync-status.json';
---
<footer class="site-footer" data-pagefind-ignore>
  <div><strong>让创作经验，持续生长。</strong><p>独立维护的 HyperFrames 中文开源指南。HyperFrames 由 HeyGen 开发。</p></div>
  <div class="footer-links"><a href="/community/about/">关于本站</a><a href="/community/contributing/">参与贡献</a><a href="/community/licenses/">许可与归属</a><a href={site.repository}>GitHub</a><a href={`${site.repository}/issues`}>反馈问题</a><a href="/rss.xml">RSS</a><a href="https://hyperframes.heygen.com/introduction">官方文档</a></div>
  <p class="sync-health">来源检查：{health.lastSuccess ? health.lastSuccess : '尚未完成'} · {health.result === 'failed' ? '最近一次检查失败，请查看维护记录' : '已记录官方来源快照'} · <a href="/community/sources/">查看维护方式</a></p>
  <p class="sync-health">维护：HyperFrames 中文指南维护者 · <a href="/llms.txt">机器阅读索引</a> · <a href="/content-manifest.json">内容与来源清单</a></p>
