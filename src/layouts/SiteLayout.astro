---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../lib/site';
import '../styles/global.css';
import '../styles/discovery.css';
interface Props { title?: string; description?: string; studioHome?: boolean; }
const { title = site.name, description = site.description, studioHome = false } = Astro.props;
---
<!doctype html><html lang="zh-CN" data-theme={studioHome ? 'light' : 'dark'} data-theme-scope={studioHome ? 'studio' : 'docs'}><head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title><meta name="description" content={description} />
  <meta name="robots" content={site.indexable ? 'index,follow' : 'noindex,nofollow'} />
  <link rel="canonical" href={new URL(Astro.url.pathname, site.url)} />
  <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><meta property="og:locale" content="zh_CN" /><meta property="og:image" content={new URL(studioHome ? '/media/studio-first-video.jpg' : '/media/product-intro.jpg', site.url)} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="alternate" type="application/rss+xml" title="HyperFrames 中文指南更新" href="/rss.xml" />
  <slot name="head" />
  <script is:inline>try{const home=document.documentElement.dataset.themeScope==='studio';const theme=localStorage.getItem(home?'hyperframes-studio-theme':'starlight-theme');if(theme==='light'||theme==='dark')document.documentElement.dataset.theme=theme}catch{}</script>
</head><body class:list={['presentation', { 'studio-home': studioHome }]}><a class="skip-link" href="#main">跳到主要内容</a><header class="header-shell"><Header /></header><main id="main" data-pagefind-body><slot /></main><Footer /></body></html>
