{
  "name": "hyperframes-cn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && node scripts/postbuild.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check && node scripts/validate-content.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "sync": "node scripts/sync.mjs",
    "sync:bootstrap": "node scripts/sync.mjs --bootstrap",
    "links": "node scripts/check-links.mjs",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler preview",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.10",
    "@astrojs/starlight": "0.43.1",
    "astro": "7.4.13",
    "gsap": "3.15.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.65.1",
    "gray-matter": "4.0.3",
    "hyperframes": "0.9.92",
    "typescript": "5.9.3",
    "wrangler": "4.168.0"
  }
}
