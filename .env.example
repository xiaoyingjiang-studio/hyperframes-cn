# Optional: the real Cloudflare default URL, or your eventual custom domain.
SITE_URL=https://xiaoyingjiang.com
SITE_INDEXABLE=false
PUBLIC_REPOSITORY=https://github.com/zhkuang/hyperframes-cn
# Complete chat/completions endpoint; no provider selected by default.
AI_ENDPOINT=
AI_MODEL=
AI_API_KEY=
AI_MAX_OUTPUT_TOKENS=6000
AI_MAX_BATCH_PAGES=5
AI_MAX_CALLS=15
AI_MAX_TOTAL_TOKENS=100000
AI_TIMEOUT_MS=60000
OPTIMIZE_MAX_PAGES=3
# Optional search-console verification values; public values, not account credentials.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
BAIDU_SITE_VERIFICATION=
# Optional IndexNow key, published as a host verification file during build.
INDEXNOW_KEY=
GSC_PROPERTY=
GSC_SERVICE_ACCOUNT_JSON=
# Deployment credentials belong in GitHub Actions Secrets.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
